# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw source dump (large, extracted WordPress backup — not needed after seeding)
/site-dump-raw/
/backup.zip

# local uploads fallback (dev only)
/public/uploads/

# local SQLite database
/prisma/dev.db
/prisma/dev.db-journal

/src/generated/prisma

# agent skills installed by the Neon Vercel integration
/.agents/
/.claude/skills/
/skills-lock.json
