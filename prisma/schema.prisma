// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

// Local dev uses SQLite (zero-setup, file-based). For production on Vercel,
// switch provider to "postgresql" and point DATABASE_URL at a Neon database
// — see README.md "Deployment" section.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// EventType is not a native Prisma enum because SQLite doesn't support enums;
// valid values are enforced in application code (see src/lib/eventTypes.ts).
model Event {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  type          String // "durga_puja" | "saraswati_puja" | "other"
  startDate     DateTime?
  endDate       DateTime?
  venueName     String?
  venueAddress  String?
  description   String
  coverImage    String?
  published     Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  galleryImages GalleryImage[]

  @@index([type])
  @@index([startDate])
}

model GalleryImage {
  id       String @id @default(cuid())
  url      String
  alt      String @default("")
  order    Int    @default(0)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
