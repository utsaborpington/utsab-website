# Local dev database (SQLite file, zero setup). For production, replace with a
# Postgres connection string (e.g. from Neon) and switch prisma/schema.prisma
# datasource provider to "postgresql". See README.md.
DATABASE_URL="file:./dev.db"

# Admin auth (see README.md "Admin access").
# IMPORTANT: this must be base64-encoded, NOT the raw bcrypt hash — Next.js's
# built-in .env variable expansion mangles the "$" characters bcrypt hashes
# contain. Generate one with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH_B64="REPLACE_WITH_BASE64_BCRYPT_HASH"
SESSION_SECRET="REPLACE_WITH_RANDOM_STRING"

# Image uploads (Vercel Blob). Leave unset in local dev — admin uploads fall
# back to local disk storage under public/uploads/ when this is not set.
BLOB_READ_WRITE_TOKEN=""

# Donation link and public contact details (optional — override the defaults in src/lib/site.ts)
GOFUNDME_URL="https://www.gofundme.com/f/help-us-bring-home-a-new-durga-maa-idol"
CONTACT_EMAIL="info@utsablondon.org"
CONTACT_PHONE="+44 7722 288179"
